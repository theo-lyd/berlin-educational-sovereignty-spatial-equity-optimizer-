PROJECT_NAME=berlin-educational-sovereignty-spatial-equity-optimizer

# DuckDB
DUCKDB_PATH=./data/warehouse/berlin_education.duckdb

# dbt
DBT_PROFILES_DIR=./dbt

# Airflow (Airflow 3 - SimpleAuthManager)
# NOTE:
# AIRFLOW_HOME must be exported in shell as:
# export AIRFLOW_HOME=$(pwd)/airflow

AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=True
AIRFLOW__CORE__EXECUTOR=LocalExecutor

# Local service ports
AIRFLOW_WEB_PORT=8080
METABASE_PORT=3000
METABASE_URL=http://localhost:3000